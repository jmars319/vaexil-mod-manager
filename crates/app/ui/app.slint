// Geist (OFL-1.1, assets/fonts/OFL.txt), embedded so text matches vaexil.tv.
import "../../../assets/fonts/Geist-Regular.ttf";
import "../../../assets/fonts/Geist-SemiBold.ttf";
import "../../../assets/fonts/Geist-Bold.ttf";
import "../../../assets/fonts/GeistMono-Regular.ttf";
import { ScrollView } from "std-widgets.slint";
import { Button, Switch, Theme, Message, Messages } from "theme.slint";
import { EditSheet, EditState, OptCheck, OptSelect } from "sheet.slint";
import { OrderList, OrderRowData, OrderState } from "order.slint";

export { Message, EditState, OptCheck, OptSelect, OrderRowData, OrderState }

export struct ModRow {
    // Set on a group heading row; the other fields are then empty.
    heading: string,
    // The id SMF's load order uses.
    id: string,
    name: string,
    detail: string,
    // 1-based load position, or 0 when the mod is off.
    position: int,
    badge: string,
    problem: string,
    can-toggle: bool,
    can-edit: bool,
    // Load-order warnings: broken rules and overridden files.
    notice: string,
}

export global Ui {
    in property <string> version;
    // "mods" or "message"
    in property <string> screen: "message";
    in property <string> game-detail;
    in property <string> chip: "Looking for HITMAN…";
    in property <bool> chip-warn;
    in property <string> heading;
    in property <string> message;
    in property <string> summary;
    in property <[ModRow]> mods;
    in property <[Message]> notes;
    // "edit" while the edit sheet is open, otherwise empty.
    in property <string> sheet;
    // "mods" or "order": which of the two views is showing.
    in-out property <string> view: "mods";
    in property <[OrderRowData]> order-rows;
    in property <string> order-summary;
    in property <bool> order-dirty;
    in property <string> order-note;
    in property <bool> order-note-error;
    callback show-order(show: bool);
    callback move-mod(index: int, delta: int);
    callback auto-sort();
    callback save-order();
    callback discard-order();
    callback toggle(id: string, on: bool);
    callback edit(id: string);
}

component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> warn;
    height: 28px;
    min-width: label.preferred-width + 24px;
    horizontal-stretch: 0;
    border-radius: self.height / 2;
    background: (warn ? Theme.warning : Theme.ready).transparentize(86%);
    border-width: 1px;
    border-color: (warn ? Theme.warning : Theme.ready).transparentize(50%);
    label := Text {
        text: root.text;
        font-size: 12px;
        font-weight: 600;
        color: root.warn ? Theme.warning : Theme.ready;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

/// A group heading such as "Sound", with how many mods it holds.
component GroupHeading inherits Rectangle {
    in property <string> text;
    min-height: label.preferred-height + 18px;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    label := Text {
        y: parent.height - self.height - 4px;
        x: 2px;
        text: root.text;
        font-size: 12px;
        font-weight: 600;
        color: Theme.secondary-text;
        accessible-role: none;
    }
}

component ModRowView inherits Rectangle {
    in property <ModRow> item;
    // A click moves the switch before the file changes, and setting
    // `checked` ends its binding, so it follows the row by hand from then on:
    // after every refresh, and right after a click (the write and refresh
    // run inside Ui.toggle, so a failed write puts it back).
    changed item => { switch.checked = root.item.position > 0; }
    min-height: content.preferred-height;
    border-radius: 12px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.surface-border;
    accessible-role: list-item;
    accessible-label: root.item.name + ", " + (root.item.position > 0 ? "on, load position " + root.item.position : "off")
        + (root.item.detail != "" ? ", " + root.item.detail : "")
        + (root.item.problem != "" ? ". Problem: " + root.item.problem : "")
        + (root.item.notice != "" ? ". " + root.item.notice : "");

    content := HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            switch := Switch {
                text: "";
                checked: root.item.position > 0;
                enabled: root.item.can-toggle;
                accessible-label: root.item.name;
                toggled => {
                    Ui.toggle(root.item.id, self.checked);
                    self.checked = root.item.position > 0;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.item.name;
                font-size: 14px;
                font-weight: 600;
                color: Theme.text;
                overflow: elide;
                accessible-role: none;
            }
            if root.item.detail != "": Text {
                text: root.item.detail;
                font-size: 12px;
                color: Theme.secondary-text;
                overflow: elide;
                accessible-role: none;
            }
            if root.item.problem != "": Text {
                text: root.item.problem;
                font-size: 12px;
                color: Theme.danger;
                wrap: word-wrap;
                accessible-role: none;
            }
            if root.item.notice != "": Text {
                text: root.item.notice;
                font-size: 12px;
                color: Theme.warning;
                wrap: word-wrap;
                accessible-role: none;
            }
        }
        if root.item.position > 0: VerticalLayout {
            alignment: center;
            Text {
                text: "#" + root.item.position;
                font-size: 12px;
                font-family: Theme.font-mono;
                color: Theme.accent;
                accessible-role: none;
            }
        }
        if root.item.can-edit: VerticalLayout {
            alignment: center;
            Button {
                text: "Edit";
                accessible-label: "Edit " + root.item.name;
                clicked => { Ui.edit(root.item.id); }
            }
        }
        if root.item.badge != "": VerticalLayout {
            alignment: center;
            Rectangle {
                height: 22px;
                width: badge-text.preferred-width + 16px;
                border-radius: 11px;
                border-width: 1px;
                border-color: Theme.surface-border;
                badge-text := Text {
                    text: root.item.badge;
                    font-size: 11px;
                    font-weight: 600;
                    color: Theme.secondary-text;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    accessible-role: none;
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Vaexil Mod Manager";
    icon: @image-url("../../../assets/icon-256.png");
    preferred-width: 980px;
    preferred-height: 720px;
    min-width: 420px;
    min-height: 480px;
    background: Theme.window-background;
    default-font-size: 13px;
    default-font-family: Theme.font-sans;

    property <length> gutter: 24px;

    // After a restore from minimized, the software renderer's partial repaint
    // left everything outside changed items unpainted. Flipping this flag
    // (from Rust) changes the full-window rectangle's colour by one step,
    // which marks the whole window dirty and repaints all of it.
    in property <bool> repaint-flip;
    Rectangle {
        background: root.repaint-flip ? Theme.window-background-alt : Theme.window-background;
        accessible-role: none;
    }

    VerticalLayout {
        HorizontalLayout {
            padding: gutter;
            padding-top: 22px;
            padding-bottom: 14px;
            spacing: 16px;
            VerticalLayout {
                alignment: center;
                spacing: 3px;
                horizontal-stretch: 1;
                Text {
                    text: "HITMAN World of Assassination";
                    font-size: 26px;
                    font-weight: 700;
                    color: Theme.text;
                    wrap: word-wrap;
                }
                if Ui.game-detail != "": Text {
                    text: Ui.game-detail;
                    font-size: 12px;
                    color: Theme.secondary-text;
                    overflow: elide;
                }
            }
            VerticalLayout {
                alignment: center;
                Chip {
                    text: Ui.chip;
                    warn: Ui.chip-warn;
                }
            }
        }

        if Ui.notes.length > 0: HorizontalLayout {
            padding-left: gutter;
            padding-right: gutter;
            padding-bottom: 12px;
            Messages { items: Ui.notes; }
        }

        if Ui.screen == "mods" && Ui.view == "order": VerticalLayout {
            vertical-stretch: 1;
            HorizontalLayout {
                padding-left: gutter;
                padding-right: gutter;
                padding-bottom: 6px;
                spacing: 10px;
                Text {
                    text: "Load order";
                    font-size: 18px;
                    font-weight: 700;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: "Back to mods";
                    clicked => { Ui.show-order(false); }
                }
                Button {
                    text: "Auto-sort";
                    clicked => { Ui.auto-sort(); }
                }
                Button {
                    text: "Discard";
                    enabled: Ui.order-dirty;
                    accessible-label: "Discard unsaved load order changes";
                    clicked => { Ui.discard-order(); }
                }
                Button {
                    text: "Save";
                    primary: true;
                    enabled: Ui.order-dirty;
                    accessible-label: "Save load order";
                    clicked => { Ui.save-order(); }
                }
            }
            VerticalLayout {
                padding-left: gutter;
                padding-right: gutter;
                padding-bottom: 10px;
                spacing: 4px;
                Text {
                    text: Ui.order-summary + ". Top loads first, and the lower mod wins.";
                    color: Theme.secondary-text;
                    wrap: word-wrap;
                }
                if Ui.order-note != "": Text {
                    text: Ui.order-note;
                    font-size: 12px;
                    color: Ui.order-note-error ? Theme.danger : Theme.ready;
                    wrap: word-wrap;
                }
            }
            OrderList {
                vertical-stretch: 1;
                rows: Ui.order-rows;
                gutter: gutter;
            }
        }

        if Ui.screen == "mods" && Ui.view != "order": VerticalLayout {
            vertical-stretch: 1;
            HorizontalLayout {
                padding-left: gutter;
                padding-right: gutter;
                padding-bottom: 10px;
                spacing: 12px;
                Text {
                    text: "Mods";
                    font-size: 18px;
                    font-weight: 700;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: Ui.summary;
                    color: Theme.secondary-text;
                    vertical-alignment: center;
                }
                Button {
                    text: "Load order";
                    clicked => { Ui.show-order(true); }
                }
            }
            list := ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    width: list.visible-width;
                    // Rows keep their own height when there are only a few.
                    alignment: start;
                    padding-left: gutter;
                    padding-right: gutter;
                    padding-bottom: gutter;
                    spacing: 8px;
                    for m in Ui.mods: Rectangle {
                        min-height: m.heading != "" ? heading.min-height : mod.min-height;
                        accessible-role: none;
                        heading := GroupHeading {
                            visible: m.heading != "";
                            text: m.heading;
                        }
                        // ScrollView scrolls a focused switch into view itself.
                        mod := ModRowView {
                            visible: m.heading == "";
                            item: m;
                        }
                    }
                }
            }
        }

        if Ui.screen == "message": VerticalLayout {
            vertical-stretch: 1;
            padding: gutter * 2;
            alignment: center;
            spacing: 12px;
            Text {
                text: Ui.heading;
                font-size: 22px;
                font-weight: 700;
                color: Theme.text;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            Text {
                text: Ui.message;
                color: Theme.secondary-text;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        HorizontalLayout {
            padding-left: gutter;
            padding-right: gutter;
            padding-top: 8px;
            padding-bottom: 12px;
            Text {
                text: "A switch changes SMF's config.json; the previous copy is kept first. The change reaches the game at the next deploy. Version " + Ui.version + ".";
                font-size: 11px;
                color: Theme.secondary-text;
                wrap: word-wrap;
            }
        }
    }

    if Ui.sheet == "edit": EditSheet { init => { self.focus(); } }
}

/// A plain message for errors before the main window exists.
export component MessageWindow inherits Window {
    in property <string> heading;
    in property <string> message;
    callback ok();

    title: "Vaexil Mod Manager";
    icon: @image-url("../../../assets/icon-256.png");
    width: 440px;
    background: Theme.surface;
    default-font-size: 13px;
    default-font-family: Theme.font-sans;
    forward-focus: ok-button;

    VerticalLayout {
        padding: 22px;
        spacing: 12px;
        Text {
            text: root.heading;
            font-size: 18px;
            font-weight: 700;
            color: Theme.text;
            wrap: word-wrap;
        }
        Text {
            text: root.message;
            color: Theme.text;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: end;
            ok-button := Button {
                text: "OK";
                primary: true;
                clicked => { root.ok(); }
            }
        }
    }
}
