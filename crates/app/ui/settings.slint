// Settings: changes outside VMM happen only from here, after the user has
// seen exactly what will change (ADR 0003, owner's decision 3).
//
// Each subject is a card with its state as a badge, so the sheet reads at a
// glance. A change that reaches outside the app opens a confirm panel in the
// card, set apart in the accent colour, and only its primary button acts.
import { ScrollView } from "std-widgets.slint";
import { Button, ButtonRow, Sheet, Switch, Theme } from "theme.slint";

/// One AI app in Settings' AI tools card.
export struct AiAppRow {
    name: string,
    found: bool,
    // Where it was found, or where to get it.
    detail: string,
    badge: string,
    // "ok", "warn", "bad", "busy" or "off", as Badge takes.
    tone: string,
    // In the app's settings (connected, added, or failed to start).
    connected: bool,
    // It can run the test request itself; otherwise the user sends it.
    can-test: bool,
    busy: bool,
    last-used: string,
    note: string,
    note-error: bool,
}

/// A request to send an AI app, in Settings' list.
export struct RequestItem {
    group: string,
    text: string,
    // Needs "Let AI tools make changes".
    change: bool,
}

export global SettingsState {
    // The full path of vmm.exe, or empty when it isn't beside the app.
    in property <string> cli-exe;
    // The folder that holds it.
    in property <string> cli-folder;
    in property <bool> on-path;
    // Showing exactly what "Add" will change, before it does.
    in property <bool> confirming;
    in property <string> note;
    in property <bool> note-error;
    callback add-to-path();
    callback confirm-add();
    callback remove-from-path();
    callback cancel-add();
    callback close();
    // "Let AI tools make changes", kept in the app's settings.json.
    in-out property <bool> ai-changes;
    in property <string> ai-note;
    callback set-ai-changes(on: bool);
    // Each AI app: found, connected, last used.
    in property <[AiAppRow]> ai-apps;
    // The app whose Connect or Disconnect is being confirmed, or -1.
    in property <int> ai-confirming: -1;
    in property <bool> ai-confirm-remove;
    // The exact command it will run.
    in property <string> ai-confirm-command;
    in property <string> ai-test-request;
    callback ai-connect(int);
    callback ai-disconnect(int);
    callback ai-confirm();
    callback ai-cancel();
    callback ai-check(int);
    callback ai-test(int);
    callback ai-sent-test(int);
    // Requests to send an AI app, with Copy.
    in property <[RequestItem]> requests: [
        { group: "Look", text: "Use vaexil-mod-manager to tell me which mods are on, in load order." },
        { group: "Look", text: "Use vaexil-mod-manager: has anything changed since my last deploy?" },
        { group: "Look", text: "Use vaexil-mod-manager to explain the warnings in my last deploy report." },
        { group: "Look", text: "Use vaexil-mod-manager to check my load order for broken rules and suggest a fix." },
        { group: "Look", text: "Use vaexil-mod-manager to show the options of <mod name> and which are chosen." },
        { group: "Change", text: "Use vaexil-mod-manager to turn off <mod name>. Show me the plan before applying it.", change: true },
        { group: "Change", text: "Use vaexil-mod-manager to choose <option> for <mod name>. Show me the plan first.", change: true },
        { group: "Change", text: "Use vaexil-mod-manager to save my current mods as a setup called <name>.", change: true },
        { group: "After a game update", text: "Use vaexil-mod-manager to start a compatibility pass with every mod off.", change: true },
        { group: "After a game update", text: "Use vaexil-mod-manager to try these mods as the next batch: <mods>.", change: true },
        { group: "After a game update", text: "Use vaexil-mod-manager to mark the current batch as good, then suggest the next one.", change: true },
        { group: "Deploy", text: "Use vaexil-mod-manager to deploy my mods and tell me when it's done.", change: true },
    ];
    // Filled just before "Copy diagnostics" copies it.
    in property <string> diagnostics;
    in property <string> diagnostics-note;
    callback make-diagnostics();
    // Steam's Play button.
    in property <string> steam-account;
    in property <string> steam-current;
    in property <string> steam-proposed;
    in property <bool> steam-connected;
    in property <bool> steam-running;
    in property <string> steam-problem;
    in property <bool> steam-confirming;
    in property <string> steam-note;
    in property <bool> steam-note-error;
    callback steam-connect();
    callback steam-confirm();
    callback steam-cancel();
    callback steam-disconnect();
    // Vaexil Mod Manager's own updates.
    in property <string> app-status;
    // For the badge: "current", "available" or "unchecked".
    in property <string> app-state;
    in property <bool> app-busy;
    in property <bool> app-confirming;
    in property <string> app-note;
    in property <bool> app-note-error;
    callback app-check();
    callback app-update();
    callback app-confirm();
    callback app-cancel();
    // Simple Mod Framework updates.
    in property <string> smf-status;
    // For the badge: "current", "available", "held", "unchecked" or "unknown".
    in property <string> smf-state;
    in property <bool> smf-can-update;
    in property <bool> smf-busy;
    in property <bool> smf-confirming;
    in property <string> smf-note;
    in property <bool> smf-note-error;
    callback smf-check();
    callback smf-update();
    callback smf-confirm();
    callback smf-cancel();
}

// Section building blocks

/// A small state label beside a card's title. `tone` is "ok", "warn",
/// "bad", "busy" or "off".
component Badge inherits Rectangle {
    in property <string> text;
    in property <string> tone: "off";
    property <color> ink: root.tone == "ok" ? Theme.ready
        : root.tone == "warn" ? Theme.warning
        : root.tone == "bad" ? Theme.danger
        : root.tone == "busy" ? Theme.running
        : Theme.secondary-text;
    height: label.preferred-height + 6px;
    width: label.preferred-width + 18px;
    border-radius: self.height / 2;
    background: root.ink.with-alpha(0.12);
    border-width: 1px;
    border-color: root.ink.with-alpha(0.35);
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    label := Text {
        text: root.text;
        font-size: 11px;
        font-weight: 600;
        color: root.ink;
        vertical-alignment: center;
        horizontal-alignment: center;
        accessible-role: none;
    }
}

/// One subject of the sheet: a titled card with its state and a short
/// description, and its controls below.
component Card inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <string> badge;
    in property <string> tone: "off";
    border-radius: 12px;
    background: Theme.window-background;
    border-width: 1px;
    border-color: Theme.surface-border;
    accessible-role: groupbox;
    accessible-label: root.title;
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 10px;
            Text {
                text: root.title;
                font-size: 15px;
                font-weight: 700;
                color: Theme.text;
                vertical-alignment: center;
                wrap: word-wrap;
            }
            if root.badge != "": VerticalLayout {
                alignment: center;
                Badge { text: root.badge; tone: root.tone; }
            }
        }
        if root.description != "": Text {
            text: root.description;
            font-size: 13px;
            color: Theme.secondary-text;
            wrap: word-wrap;
        }
        @children
    }
}

/// The second step of a change: what it will do, set apart so the button
/// that makes it can't be missed.
component Confirm inherits Rectangle {
    in property <string> heading;
    border-radius: 10px;
    background: Theme.accent.with-alpha(0.08);
    border-width: 2px;
    border-color: Theme.accent;
    accessible-role: groupbox;
    accessible-label: root.heading;
    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        Text {
            text: root.heading;
            font-size: 13px;
            font-weight: 700;
            color: Theme.accent;
            wrap: word-wrap;
        }
        @children
    }
}

/// A value shown exactly, such as a path or a command line.
component Mono inherits Rectangle {
    in property <string> text;
    border-radius: 6px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.surface-border;
    min-height: field.preferred-height + 12px;
    field := Text {
        x: 8px;
        width: parent.width - 16px;
        text: root.text;
        font-family: Theme.font-mono;
        font-size: 12px;
        color: Theme.text;
        wrap: word-wrap;
        vertical-alignment: center;
    }
}

/// The outcome of the last action in a card.
component Note inherits Text {
    in property <bool> error;
    in property <bool> quiet;
    font-size: 12px;
    color: root.error ? Theme.danger : root.quiet ? Theme.secondary-text : Theme.ready;
    wrap: word-wrap;
}

/// A line of buttons that starts at the left edge.
component Actions inherits HorizontalLayout {
    alignment: start;
    spacing: 8px;
}

/// One AI app: where it is, whether it is connected, and its buttons.
component AiAppItem inherits Rectangle {
    in property <AiAppRow> app;
    in property <int> index;
    border-radius: 10px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.surface-border;
    accessible-role: groupbox;
    accessible-label: root.app.name;
    VerticalLayout {
        padding: 12px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.app.name;
                font-size: 13px;
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: center;
            }
            VerticalLayout {
                alignment: center;
                Badge { text: root.app.badge; tone: root.app.tone; }
            }
        }
        Text {
            text: root.app.detail;
            font-size: 12px;
            color: Theme.secondary-text;
            wrap: word-wrap;
        }
        if root.app.last-used != "": Text {
            text: root.app.last-used;
            font-size: 12px;
            color: Theme.ready;
            wrap: word-wrap;
        }
        if SettingsState.ai-confirming == root.index: Confirm {
            heading: SettingsState.ai-confirm-remove ? "Confirm: remove Vaexil Mod Manager from " + root.app.name
                : "Confirm: connect " + root.app.name;
            Text {
                text: "This runs " + root.app.name + "'s own command:";
                font-size: 12px;
                color: Theme.text;
                wrap: word-wrap;
            }
            Mono { text: SettingsState.ai-confirm-command; }
            Text {
                text: SettingsState.ai-confirm-remove
                    ? "Only Vaexil Mod Manager's entry is removed from " + root.app.name + "'s settings."
                    : root.app.name + " adds Vaexil Mod Manager to its own settings, for all your projects. Sessions started afterwards can read your mods; changes still need \u{201c}Let AI tools make changes\u{201d} above. You can remove it here.";
                font-size: 12px;
                color: Theme.secondary-text;
                wrap: word-wrap;
            }
            ButtonRow {
                Button {
                    text: "Cancel";
                    accessible-label: "Cancel, " + root.app.name;
                    clicked => { SettingsState.ai-cancel(); }
                }
                Button {
                    text: SettingsState.ai-confirm-remove ? "Remove" : "Connect";
                    accessible-label: (SettingsState.ai-confirm-remove ? "Remove from " : "Connect ") + root.app.name + " now";
                    primary: true;
                    clicked => { SettingsState.ai-confirm(); }
                }
            }
        }
        if SettingsState.ai-confirming != root.index && root.app.found && !root.app.busy: Actions {
            if !root.app.connected: Button {
                text: "Connect…";
                accessible-label: "Connect " + root.app.name;
                clicked => { SettingsState.ai-connect(root.index); }
            }
            if root.app.connected && root.app.can-test: Button {
                text: "Test it";
                accessible-label: "Test " + root.app.name;
                clicked => { SettingsState.ai-test(root.index); }
            }
            if root.app.connected && !root.app.can-test: Button {
                text: "Copy a test request";
                accessible-label: "Copy a test request for " + root.app.name;
                clicked => {
                    test-field.select-all();
                    test-field.copy();
                    test-field.clear-selection();
                    SettingsState.ai-sent-test(root.index);
                }
            }
            Button {
                text: "Check";
                accessible-label: "Check " + root.app.name;
                clicked => { SettingsState.ai-check(root.index); }
            }
            if root.app.connected: Button {
                text: "Remove…";
                accessible-label: "Remove Vaexil Mod Manager from " + root.app.name;
                clicked => { SettingsState.ai-disconnect(root.index); }
            }
        }
        if root.app.note != "": Note { text: root.app.note; error: root.app.note-error; quiet: !root.app.note-error; }
        // Holds the test request only to copy it; never shown.
        // Wrapped, so its long text never widens the sheet.
        test-field := TextInput {
            visible: false;
            height: 0px;
            single-line: false;
            wrap: word-wrap;
            text: SettingsState.ai-test-request;
            read-only: true;
            accessible-role: none;
        }
    }
}

/// One request, with Copy.
component RequestRow inherits HorizontalLayout {
    in property <RequestItem> item;
    property <bool> copied;
    spacing: 10px;
    Text {
        text: root.item.text;
        font-size: 12px;
        color: Theme.text;
        wrap: word-wrap;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
    if root.item.change: VerticalLayout {
        alignment: center;
        Badge { text: "Changes"; tone: "warn"; }
    }
    VerticalLayout {
        alignment: center;
        Button {
            text: root.copied ? "Copied" : "Copy";
            font-size: 12px;
            accessible-label: "Copy: " + root.item.text;
            clicked => {
                field.select-all();
                field.copy();
                field.clear-selection();
                root.copied = true;
            }
        }
    }
    // Holds the request only to copy it; never shown.
    field := TextInput {
        visible: false;
        width: 0px;
        height: 0px;
        single-line: false;
        wrap: word-wrap;
        text: root.item.text;
        read-only: true;
        accessible-role: none;
    }
}

export component SettingsSheet inherits Sheet {
    title: "Settings";
    subtitle: "Changes outside Vaexil Mod Manager happen only from here, and only when you confirm them.";
    panel-width: 640px;
    close => { SettingsState.close(); }

    // The cards scroll and Close stays in view, so a short window never
    // hides it. The sheet's title, subtitle and Close take about 240px.
    body := ScrollView {
        height: min(inner.preferred-height, max(160px, root.height - 250px));
        inner := VerticalLayout {
            width: body.visible-width;
            padding-right: 10px;
            spacing: 12px;

            // Steam's Play button
            Card {
                title: "Steam's Play button";
                description: "Make Steam's own Play button start HITMAN through Vaexil Mod Manager. If your mods changed since the last deploy, it asks whether to deploy first or play the build already in the game; otherwise the game just starts.";
                badge: SettingsState.steam-problem != "" ? "Unavailable" : SettingsState.steam-connected ? "On" : "Off";
                tone: SettingsState.steam-problem != "" ? "bad" : SettingsState.steam-connected ? "ok" : "off";
                Text {
                    text: SettingsState.steam-problem != "" ? SettingsState.steam-problem
                        : SettingsState.steam-connected ? "Steam (" + SettingsState.steam-account + ") starts HITMAN through Vaexil Mod Manager."
                        : "Steam (" + SettingsState.steam-account + ") starts HITMAN directly. Its launch options now: " + (SettingsState.steam-current == "" ? "none" : SettingsState.steam-current);
                    font-size: 12px;
                    color: SettingsState.steam-problem != "" ? Theme.danger : Theme.text;
                    wrap: word-wrap;
                }
                if SettingsState.steam-confirming: Confirm {
                    heading: "Confirm: change HITMAN's launch options in Steam";
                    Text {
                        text: "For " + SettingsState.steam-account + ", HITMAN's launch options become:";
                        font-size: 12px;
                        color: Theme.text;
                        wrap: word-wrap;
                    }
                    Mono { text: SettingsState.steam-proposed; }
                    Text {
                        text: "This replaces " + (SettingsState.steam-current == "" ? "no launch options" : "\u{201c}" + SettingsState.steam-current + "\u{201d}") + ". A copy of Steam's settings is kept first, nothing else in them changes, and you can put them back here. Steam must be closed.";
                        font-size: 12px;
                        color: Theme.secondary-text;
                        wrap: word-wrap;
                    }
                    ButtonRow {
                        Button {
                            text: "Cancel";
                            accessible-label: "Cancel changing Steam's Play button";
                            clicked => { SettingsState.steam-cancel(); }
                        }
                        Button {
                            text: "Change Steam's launch options";
                            primary: true;
                            clicked => { SettingsState.steam-confirm(); }
                        }
                    }
                }
                if !SettingsState.steam-confirming && SettingsState.steam-problem == "": Actions {
                    if !SettingsState.steam-connected: Button {
                        text: "Use Vaexil Mod Manager for Steam's Play button…";
                        accessible-label: "Use Vaexil Mod Manager for Steam's Play button";
                        clicked => { SettingsState.steam-connect(); }
                    }
                    if SettingsState.steam-connected: Button {
                        text: "Put Steam's launch options back";
                        clicked => { SettingsState.steam-disconnect(); }
                    }
                }
                if SettingsState.steam-note != "": Note {
                    text: SettingsState.steam-note;
                    error: SettingsState.steam-note-error;
                }
            }

            // Vaexil Mod Manager itself
            Card {
                title: "Vaexil Mod Manager";
                description: "New versions come from the shared release feed on GitHub. Updating checks the installer against the feed's SHA-256, installs it, and reopens the app.";
                badge: SettingsState.app-busy ? "Working"
                    : SettingsState.app-state == "current" ? "Up to date"
                    : SettingsState.app-state == "available" ? "Update available"
                    : "Not checked";
                tone: SettingsState.app-busy ? "busy"
                    : SettingsState.app-state == "current" ? "ok"
                    : SettingsState.app-state == "available" ? "warn"
                    : "off";
                Text {
                    text: SettingsState.app-status;
                    font-size: 12px;
                    color: Theme.text;
                    wrap: word-wrap;
                }
                if SettingsState.app-confirming: Confirm {
                    heading: "Confirm: update Vaexil Mod Manager";
                    Text {
                        text: "This downloads the installer, checks it against the SHA-256 the feed gives, closes this window, installs, and reopens it. Your mods, setups and settings stay. An AI app's open session keeps its current tools until you start a new one.";
                        font-size: 12px;
                        color: Theme.text;
                        wrap: word-wrap;
                    }
                    ButtonRow {
                        Button {
                            text: "Cancel";
                            accessible-label: "Cancel updating Vaexil Mod Manager";
                            clicked => { SettingsState.app-cancel(); }
                        }
                        Button {
                            text: "Update and reopen";
                            primary: true;
                            clicked => { SettingsState.app-confirm(); }
                        }
                    }
                }
                if !SettingsState.app-confirming && !SettingsState.app-busy: Actions {
                    Button {
                        text: "Check for updates";
                        accessible-label: "Check for Vaexil Mod Manager updates";
                        clicked => { SettingsState.app-check(); }
                    }
                    if SettingsState.app-state == "available": Button {
                        text: "Update…";
                        accessible-label: "Update Vaexil Mod Manager";
                        clicked => { SettingsState.app-update(); }
                    }
                }
                if SettingsState.app-note != "": Note {
                    text: SettingsState.app-note;
                    error: SettingsState.app-note-error;
                    quiet: SettingsState.app-busy;
                }
            }

            // Simple Mod Framework
            Card {
                title: "Simple Mod Framework";
                description: "Vaexil Mod Manager runs the official SMF in the HITMAN folder, and can keep it current the way SMF's own updater does.";
                badge: SettingsState.smf-busy ? "Working"
                    : SettingsState.smf-state == "current" ? "Up to date"
                    : SettingsState.smf-state == "available" ? "Update available"
                    : SettingsState.smf-state == "held" ? "Update by hand"
                    : SettingsState.smf-state == "unchecked" ? "Not checked"
                    : "Unknown version";
                tone: SettingsState.smf-busy ? "busy"
                    : SettingsState.smf-state == "current" ? "ok"
                    : SettingsState.smf-state == "available" || SettingsState.smf-state == "held" ? "warn"
                    : "off";
                Text {
                    text: SettingsState.smf-status;
                    font-size: 12px;
                    color: Theme.text;
                    wrap: word-wrap;
                }
                if SettingsState.smf-confirming: Confirm {
                    heading: "Confirm: update SMF";
                    Text {
                        text: "This downloads SMF's Release.zip from its GitHub page, checks it against the checksum GitHub gives, and installs it the way SMF's own updater does. Your mods, config.json and SMF's clean copies stay, and a copy of every replaced file is kept. HITMAN and SMF's own Mod Manager must be closed. Deploy afterwards to use it.";
                        font-size: 12px;
                        color: Theme.text;
                        wrap: word-wrap;
                    }
                    ButtonRow {
                        Button {
                            text: "Cancel";
                            accessible-label: "Cancel updating SMF";
                            clicked => { SettingsState.smf-cancel(); }
                        }
                        Button {
                            text: "Update SMF";
                            primary: true;
                            clicked => { SettingsState.smf-confirm(); }
                        }
                    }
                }
                if !SettingsState.smf-confirming && !SettingsState.smf-busy: Actions {
                    Button {
                        text: "Check for updates";
                        accessible-label: "Check for SMF updates";
                        clicked => { SettingsState.smf-check(); }
                    }
                    if SettingsState.smf-can-update: Button {
                        text: "Update SMF…";
                        accessible-label: "Update SMF";
                        clicked => { SettingsState.smf-update(); }
                    }
                }
                if SettingsState.smf-note != "": Note {
                    text: SettingsState.smf-note;
                    error: SettingsState.smf-note-error;
                    quiet: SettingsState.smf-busy;
                }
            }

            // AI tools
            Card {
                title: "AI tools";
                description: "“vmm mcp” lets an AI app such as Claude Code, Gemini CLI or Codex CLI read your mods and, if you allow it here, change them when you ask. It runs only while the AI app runs it, and makes no network connection.";
                badge: SettingsState.ai-changes ? "Changes allowed" : "Read only";
                tone: SettingsState.ai-changes ? "warn" : "off";
                Actions {
                    Switch {
                        text: "Let AI tools make changes";
                        checked: SettingsState.ai-changes;
                        toggled => {
                            SettingsState.set-ai-changes(self.checked);
                            self.checked = SettingsState.ai-changes;
                        }
                    }
                }
                Text {
                    text: SettingsState.ai-changes
                        ? "An AI tool changes something only when you have asked for it, after showing you the plan. Each change is recorded with your request in journal.jsonl."
                        : "AI tools can read your mods and plan changes, but can't apply them.";
                    font-size: 12px;
                    color: Theme.secondary-text;
                    wrap: word-wrap;
                }
                if SettingsState.ai-note != "": Note { text: SettingsState.ai-note; error: true; }
                VerticalLayout {
                    spacing: 8px;
                    padding-top: 4px;
                    Text {
                        text: "Connect an AI app";
                        font-size: 13px;
                        font-weight: 600;
                        color: Theme.text;
                    }
                    Text {
                        text: "Connect runs the AI app's own command for adding a server, after showing it to you; Vaexil Mod Manager doesn't edit other apps' settings. Check asks the app whether the connection works, and the line in green shows the last time it really reached Vaexil Mod Manager.";
                        font-size: 12px;
                        color: Theme.secondary-text;
                        wrap: word-wrap;
                    }
                    for app[i] in SettingsState.ai-apps: AiAppItem { app: app; index: i; }
                }
            }

            // Requests to try
            Card {
                title: "Requests to try";
                description: "Copy one, fill in anything in <angle brackets>, and send it to your AI app. Those marked Changes need \u{201c}Let AI tools make changes\u{201d}; the AI shows you the plan before applying it.";
                for item[i] in SettingsState.requests: VerticalLayout {
                    spacing: 6px;
                    if i == 0 || SettingsState.requests[i - 1].group != item.group: Text {
                        text: item.group;
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.secondary-text;
                    }
                    RequestRow { item: item; }
                }
            }

            // Command line
            Card {
                title: "Command line";
                description: "vmm.exe does what the window does, from a terminal or an AI tool: “vmm status”, “vmm mods”, and for changes “vmm plan” then “vmm apply --yes”. Add --json for output that tools can read.";
                badge: SettingsState.cli-exe == "" ? "Missing" : SettingsState.on-path ? "On PATH" : "Not on PATH";
                tone: SettingsState.cli-exe == "" ? "bad" : SettingsState.on-path ? "ok" : "off";
                if SettingsState.cli-exe != "": Mono { text: SettingsState.cli-exe; }
                Text {
                    text: SettingsState.cli-exe == "" ? "vmm.exe isn't beside the app, so it can't be added to PATH. Reinstall Vaexil Mod Manager to get it."
                        : SettingsState.on-path ? "It is on your PATH, so vmm works in any new terminal."
                        : "It isn't on your PATH. Until it is, run it by its full path.";
                    font-size: 12px;
                    color: Theme.secondary-text;
                    wrap: word-wrap;
                }
                if SettingsState.confirming: Confirm {
                    heading: "Confirm: add the command line to your PATH";
                    Text {
                        text: "This adds one folder to the end of your own PATH (the Path value in HKEY_CURRENT_USER\\Environment):";
                        font-size: 12px;
                        color: Theme.text;
                        wrap: word-wrap;
                    }
                    Mono { text: SettingsState.cli-folder; }
                    Text {
                        text: "Nothing else in PATH changes, and the system PATH isn't touched. Terminals opened afterwards find vmm; ones already open don't. You can take it out again here.";
                        font-size: 12px;
                        color: Theme.secondary-text;
                        wrap: word-wrap;
                    }
                    ButtonRow {
                        Button {
                            text: "Cancel";
                            accessible-label: "Cancel adding to PATH";
                            clicked => { SettingsState.cancel-add(); }
                        }
                        Button {
                            text: "Add to PATH";
                            primary: true;
                            clicked => { SettingsState.confirm-add(); }
                        }
                    }
                }
                if !SettingsState.confirming && SettingsState.cli-exe != "": Actions {
                    if !SettingsState.on-path: Button {
                        text: "Add the command line to my PATH…";
                        accessible-label: "Add the command line to my PATH";
                        clicked => { SettingsState.add-to-path(); }
                    }
                    if SettingsState.on-path: Button {
                        text: "Take it out of my PATH";
                        accessible-label: "Take the command line out of my PATH";
                        clicked => { SettingsState.remove-from-path(); }
                    }
                }
                if SettingsState.note != "": Note { text: SettingsState.note; error: SettingsState.note-error; }
            }

            // Diagnostics
            Card {
                title: "Diagnostics";
                description: "Copies everything needed to look into a problem: how the game was found, current problems, the last deploy, recent events and settings, as JSON. Paths in your user folder start with ~.";
                Actions {
                    spacing: 10px;
                    Button {
                        text: "Copy diagnostics";
                        clicked => {
                            SettingsState.make-diagnostics();
                            diag-field.select-all();
                            diag-field.copy();
                            diag-field.clear-selection();
                        }
                    }
                    if SettingsState.diagnostics-note != "": Text {
                        text: SettingsState.diagnostics-note;
                        font-size: 12px;
                        color: Theme.ready;
                        vertical-alignment: center;
                    }
                }
                // Holds the text only to copy it; never shown. A zero-width
                // field doesn't copy, so it stays full width in the card.
                diag-field := TextInput {
                    visible: false;
                    height: 0px;
                    single-line: false;
                    wrap: word-wrap;
                    text: SettingsState.diagnostics;
                    read-only: true;
                    accessible-role: none;
                }
            }
        }
    }

    ButtonRow {
        Button {
            text: "Close";
            accessible-label: "Close settings";
            clicked => { SettingsState.close(); }
        }
    }
}
