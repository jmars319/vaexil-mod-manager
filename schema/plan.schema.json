{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "planId": {
      "type": "string",
      "description": "The handle to apply it with. A plan is used once."
    },
    "game": {
      "type": "string",
      "description": "The game folder it is for."
    },
    "changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Change"
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PlanStep"
      },
      "description": "One step per change, in order."
    },
    "preconditions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Precondition"
      },
      "description": "Applying refuses if any of these files has changed since."
    },
    "createdAtMs": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "expiresAtMs": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0,
      "description": "After this (10 minutes on), the plan can't be applied; plan again."
    }
  },
  "required": [
    "schemaVersion",
    "planId",
    "game",
    "changes",
    "steps",
    "preconditions",
    "createdAtMs",
    "expiresAtMs"
  ],
  "description": "A checked set of changes, waiting to be applied by its `planId`.",
  "title": "Plan",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Change": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "setEnabled"
            },
            "mod": {
              "type": "string"
            },
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "op",
            "mod",
            "enabled"
          ],
          "description": "Turn a mod on (placed where its rules want it) or off."
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "setOptions"
            },
            "mod": {
              "type": "string"
            },
            "chosen": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "op",
            "mod",
            "chosen"
          ],
          "description": "Choose exactly these options of a mod, by their `value`s."
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "setKind"
            },
            "mod": {
              "type": "string"
            },
            "kind": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ModKind"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            }
          },
          "required": [
            "op",
            "mod"
          ],
          "description": "Set the type shown for a mod, or with no `kind`, go back to the type\nworked out from its files."
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "reorder"
            },
            "order": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "op",
            "order"
          ],
          "description": "A new load order. It must hold exactly the mods that are on at that\npoint of the plan."
        }
      ],
      "description": "One change to make. Every change is planned first and applied by its plan."
    },
    "ModKind": {
      "type": "string",
      "enum": [
        "gameplay",
        "models-textures",
        "sound",
        "dialogue",
        "ui",
        "text",
        "other"
      ],
      "description": "What a mod mostly changes, for grouping the Mods view. Information only:\nit never affects what the framework loads."
    },
    "PlanStep": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "description": "What the step does, in plain words."
        },
        "changesSomething": {
          "type": "boolean",
          "description": "False when the game is already that way, so the step writes nothing."
        }
      },
      "required": [
        "description",
        "changesSomething"
      ]
    },
    "Precondition": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "description": "The SHA-256 of the file, or absent when there was no file."
        }
      },
      "required": [
        "path"
      ],
      "description": "A file a plan depends on, and its contents when it was made."
    }
  }
}
